---
import '../styles/global.css';
import { nav } from '../data/nav';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Aethernal: our WoW server, characters, MTG decks and other projects.' } = Astro.props;
const fullTitle = title ? `${title} · Aethernal` : 'Aethernal';
const path = Astro.url.pathname;

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#040b0d" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://aethernal.net/images/banner.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">
          <img src="/images/logo.webp" alt="" width="36" height="36" />
          <span>Aethernal</span>
        </a>
        <button class="nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
        <nav id="site-nav" aria-label="Main">
          {nav.map((item, i) => (
            <>
              {item.group && item.group !== nav[i - 1]?.group && (
                <span class="nav-group" title={item.group}>
                  {item.groupIcon && <img src={item.groupIcon} alt="" width="20" height="20" />}
                  <span class:list={['nav-group-name', { 'has-icon': item.groupIcon }]}>{item.group}</span>
                </span>
              )}
              {item.children ? (
                <span class="nav-item">
                  <a href={item.href} data-same-tab aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
                  <span class="nav-sub">
                    <span class="nav-menu">
                      {item.children.map((child) => (
                        <a href={child.href} data-same-tab aria-current={isActive(child.href) ? 'page' : undefined}>{child.label}</a>
                      ))}
                    </span>
                  </span>
                </span>
              ) : (
                <a href={item.href} data-same-tab aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
              )}
            </>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container">
        <span>Aethernal</span>
        <span class="dot" aria-hidden="true">&#9670;</span>
        <a href="https://github.com/ChakraaThePanda">GitHub</a>
        <span class="dot" aria-hidden="true">&#9670;</span>
        <a href="https://wow.aethernal.net/" data-same-tab>WoW Server</a>
      </div>
    </footer>
    <script is:inline>
      // Phone menu: the burger opens the nav as a panel under the header.
      (() => {
        const header = document.querySelector('.site-header');
        const toggle = header.querySelector('.nav-toggle');
        const setOpen = (open) => {
          header.classList.toggle('open', open);
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
        };
        toggle.addEventListener('click', () => setOpen(!header.classList.contains('open')));
        header.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
        document.addEventListener('click', (e) => { if (!header.contains(e.target)) setOpen(false); });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && header.classList.contains('open')) { setOpen(false); toggle.focus(); }
        });
      })();

      // Every link to another site opens in a new tab, including ones added later by page scripts.
      // Menu links are exempt so moving to the account panel feels like the same site.
      const markExternal = (a) => {
        if (a.host && a.host !== location.host && !a.hasAttribute('data-same-tab')) {
          a.target = '_blank';
          a.rel = 'noopener';
        }
      };
      document.querySelectorAll('a[href]').forEach(markExternal);
      document.addEventListener('click', (e) => {
        const a = e.target.closest?.('a[href]');
        if (a) markExternal(a);
      }, true);
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 10;
    background: rgba(var(--bg-rgb), 0.85);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 60px; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--text); font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; letter-spacing: 0.05em; }
  .brand img { filter: drop-shadow(0 0 6px rgba(var(--accent-rgb), 0.45)); }
  nav { display: flex; gap: 4px; flex-wrap: wrap; align-items: center; }
  .nav-group {
    display: flex; align-items: center; gap: 8px;
    margin-left: 8px; padding: 2px 4px 2px 14px; border-left: 1px solid var(--border);
    font-family: var(--font-display); font-weight: 700; font-size: 0.72rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent);
  }
  /* On desktop a group with an icon shows just the icon (the name is its tooltip). */
  .nav-group-name.has-icon {
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }
  nav a {
    color: var(--muted); text-decoration: none; font-weight: 500; font-size: 0.95rem;
    padding: 6px 12px; border-radius: 6px;
  }
  nav a:hover { color: var(--text); background: var(--accent-soft); }
  nav a[aria-current="page"] { color: var(--accent); background: var(--accent-soft); }

  /* An item with sub-pages (Server > Armory): a small menu that opens on hover or keyboard focus. */
  .nav-item { position: relative; display: flex; }
  .nav-sub {
    display: none;
    /* padding-top bridges the gap so the pointer can move from the item into the menu. */
    position: absolute; top: 100%; left: 50%; transform: translateX(-50%); z-index: 1; padding-top: 6px;
  }
  .nav-item:hover .nav-sub, .nav-item:focus-within .nav-sub { display: block; }
  .nav-menu {
    display: flex; flex-direction: column; gap: 2px; min-width: 140px; padding: 6px;
    background: var(--bg); border: 1px solid var(--border); border-radius: 8px;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.5);
  }
  .nav-menu a { white-space: nowrap; }

  .nav-toggle { display: none; }

  /* Phones and narrow tablets: one slim row with a burger; the menu drops down under it.
     Without JavaScript (no .js class) the menu just stays visible and wraps. */
  @media (max-width: 640px) {
    .header-inner { flex-wrap: nowrap; }
    :global(.js) .nav-toggle {
      display: flex; flex-direction: column; justify-content: center; gap: 5px;
      width: 44px; height: 44px; margin-right: -8px; padding: 0 10px;
      background: none; border: 0; border-radius: 6px; cursor: pointer;
    }
    .nav-toggle span {
      display: block; height: 2px; border-radius: 2px; background: var(--text);
      transition: transform 0.2s, opacity 0.2s;
    }
    .nav-toggle:hover, .nav-toggle:focus-visible { background: var(--accent-soft); }
    .open .nav-toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .open .nav-toggle span:nth-child(2) { opacity: 0; }
    .open .nav-toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    :global(.js) nav {
      display: none;
      position: absolute; top: 100%; left: 0; right: 0;
      flex-direction: column; align-items: stretch; gap: 2px;
      padding: 8px 16px 14px;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.5);
    }
    :global(.js) .open nav { display: flex; }
    nav a { padding: 10px 12px; font-size: 1rem; }
    .nav-group {
      margin: 8px 0 2px; padding: 10px 12px 4px; border-left: 0; border-top: 1px solid var(--border);
      font-family: var(--font-body); font-size: 0.85rem; font-weight: 600;
      letter-spacing: 0.02em; text-transform: none; color: var(--muted);
    }
    .nav-group-name.has-icon { position: static; width: auto; height: auto; overflow: visible; clip-path: none; }
    .nav-group ~ a, .nav-group ~ .nav-item > a { padding-left: 40px; }
    /* Sub-pages are always listed, one step further in, with a short line marking them as the item's. */
    .nav-item { display: contents; }
    .nav-sub, .nav-item:hover .nav-sub { display: block; position: static; transform: none; padding: 0; }
    .nav-menu { min-width: 0; padding: 0; background: none; border: 0; border-radius: 0; box-shadow: none; }
    .nav-menu a { position: relative; padding-left: 60px; }
    .nav-menu a::before {
      content: ''; position: absolute; left: 44px; top: 50%; width: 8px; height: 1px; background: var(--border);
    }
  }
  .site-footer { border-top: 1px solid var(--border); padding: 20px 0; color: var(--muted); font-size: 0.85rem; }
  .site-footer .container { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .site-footer a { color: var(--muted); text-decoration: none; }
  .site-footer a:hover { color: var(--accent); }
  .site-footer .dot { color: var(--accent); font-size: 0.6rem; align-self: center; }
</style>
