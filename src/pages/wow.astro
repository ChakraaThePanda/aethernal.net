---
import Base from '../layouts/Base.astro';
import RetailCharacter from '../components/RetailCharacter.astro';
import OwnerFilter from '../components/OwnerFilter.astro';
import { aethernalApi, blizzardCharacters } from '../data/characters';
import { sortRoster } from '../lib/wow';
import { loadRetail } from '../lib/retail';

// Everyone who owns a Battle.net character, for the filter buttons. Aethernal owners come from the
// realm API and are added once it answers.
const owners = [...new Set(blizzardCharacters.map((c) => c.owner).filter(Boolean))];

// Battle.net characters split by game. The Forever section only shows once a character has
// game: 'forever' in characters.ts. The page script sorts the Aethernal cards the same way.
const fetched = loadRetail()?.characters;
const retail = fetched && sortRoster(fetched.filter((c) => (c.game ?? 'retail') === 'retail'), owners);
const forever = sortRoster((fetched ?? []).filter((c) => c.game === 'forever'), owners);
const foreverListed = blizzardCharacters.some((c) => c.game === 'forever');
---
<Base title="World of Warcraft" description="Live World of Warcraft character profiles on Retail, Forever and the Aethernal server.">
  <h1>World of Warcraft</h1>
  <p class="lead">Our characters on Retail, Forever and Aethernal.</p>

  <OwnerFilter owners={owners} />

  <section data-filter-group>
    <h2 class="section-title">Retail</h2>
    {retail ? (
      <div class="chars">
        {retail.map((c: any) => <RetailCharacter c={c} />)}
      </div>
    ) : (
      <p class="panel empty muted">Retail profiles appear here after the next deploy fetches them from Battle.net.</p>
    )}
  </section>

  {foreverListed && (
    <section data-filter-group>
      <h2 class="section-title">Forever</h2>
      {forever.length ? (
        <div class="chars">
          {forever.map((c: any) => <RetailCharacter c={c} />)}
        </div>
      ) : (
        <p class="panel empty muted">Forever profiles appear here after the next deploy fetches them from Battle.net.</p>
      )}
    </section>
  )}

  <section data-filter-group>
    <h2 class="section-title">Aethernal <span id="realm-status" class="realm-status" hidden></span></h2>
    <div id="aethernal" class="chars" data-api={aethernalApi}>
      <p class="panel empty muted">Contacting the realm…</p>
    </div>
  </section>

  <script is:inline slot="head">
    const whTooltips = { colorLinks: false, iconizeLinks: true, renameLinks: false, iconSize: 'small' };
  </script>
  <script is:inline slot="head" src="https://wow.zamimg.com/js/tooltips.js" defer></script>
</Base>

<script>
  import { CLASS_COLORS, sortRoster } from '../lib/wow';

  // Aethernal: fetched live from the account panel's public API.
  const root = document.getElementById('aethernal');
  const statusEl = document.getElementById('realm-status');
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (ch) => `&#${ch.charCodeAt(0)};`);
  // AzerothCore has no character renders, so the portrait is Wowhead's class icon with a small
  // race/gender icon in the corner.
  const ICONS = 'https://wow.zamimg.com/images/wow/icons/large';
  const slug = (s) => String(s).toLowerCase().replace(/\s+/g, '');
  const classIcon = (c) => `${ICONS}/classicon_${slug(c.className)}.jpg`;
  const raceIcon = (c) =>
    `${ICONS}/race_${c.race === 'Undead' ? 'scourge' : slug(c.race)}_${c.gender === 'Female' ? 'female' : 'male'}.jpg`;
  const played = (sec) => {
    const h = Math.floor(sec / 3600);
    return h >= 24 ? `${Math.floor(h / 24)}d ${h % 24}h` : `${h}h`;
  };

  function card(c) {
    const owner = c.owner;
    const color = CLASS_COLORS[c.className] || 'var(--text)';
    const gear = (c.equipment || [])
      .map((i) => `<li><span class="slot">${esc(i.slot)}</span>`
        + `<a href="https://www.wowhead.com/wotlk/item=${i.entry}" target="_blank" rel="noopener" style="color: var(--q${Number(i.quality) || 0})">${esc(i.name)}</a>`
        + `<span class="ilvl">${i.itemLevel ?? ''}</span></li>`)
      .join('');
    return `
      <article class="char panel" style="--class: ${color}" data-filter-item data-owner="${esc(owner || '')}">
        ${owner || c.hardcore ? `<div class="tags">${owner ? `<span class="owner" data-owner="${esc(owner)}">${esc(owner)}</span>` : ''}${c.hardcore ? '<span class="hardcore" title="Hardcore">HC</span>' : ''}</div>` : ''}
        <div class="body">
          <header>
            <div class="portrait">
              <img class="class-icon" src="${classIcon(c)}" alt="${esc(c.className)}" width="56" height="56" loading="lazy">
              <img class="race-icon" src="${raceIcon(c)}" alt="${esc(`${c.gender} ${c.race}`)}" width="24" height="24" loading="lazy">
            </div>
            <div>
              <h3 class="cname">${esc(c.name)}
                <span class="dot ${c.online ? 'on' : ''}" title="${c.online ? 'Online' : 'Offline'}"></span>
              </h3>
              <div class="sub">Level ${c.level} ${esc(c.race)} <span class="cls">${c.spec ? `${esc(c.spec)} ` : ''}${esc(c.className)}</span></div>
              ${c.guild ? `<div class="sub muted">&lt;${esc(c.guild)}&gt;</div>` : ''}
            </div>
          </header>
          <dl class="stats">
            ${c.itemLevel ? `<div><dt>Item level</dt><dd>${c.itemLevel}</dd></div>` : ''}
            <div><dt>Played</dt><dd>${played(c.playedSeconds || 0)}</dd></div>
            ${c.honorableKills ? `<div><dt>Honor kills</dt><dd>${c.honorableKills}</dd></div>` : ''}
          </dl>
          ${gear ? `<details class="acc"><summary><span>Equipment</span></summary><ul class="gear">${gear}</ul></details>` : ''}
          <footer class="small muted">${c.online ? 'Online now' : c.lastSeen ? `Last seen ${new Date(c.lastSeen).toLocaleDateString('en-CA', { dateStyle: 'medium' })}` : ''}</footer>
        </div>
      </article>`;
  }

  async function loadAethernal() {
    try {
      const res = await fetch(root.dataset.api);
      if (!res.ok) throw new Error(res.status);
      const data = await res.json();
      statusEl.hidden = false;
      statusEl.className = `realm-status ${data.realm.online ? 'on' : 'off'}`;
      statusEl.textContent = data.realm.online ? `Online · ${data.realm.playersOnline} playing` : 'Offline';
      window.addFilterOwners?.(data.characters.map((c) => c.owner));
      // Same order as the Battle.net cards, with the owners in filter-button order.
      const owners = [...document.querySelectorAll('.owner-filter [data-owner]')].map((b) => b.dataset.owner);
      const chars = sortRoster(data.characters, owners);
      root.innerHTML = chars.length
        ? chars.map(card).join('')
        : '<p class="panel empty muted">No characters to show yet.</p>';
      window.applyOwnerFilter?.();
      window.$WowheadPower?.refreshLinks();
    } catch {
      statusEl.hidden = false;
      statusEl.className = 'realm-status off';
      statusEl.textContent = 'Unreachable';
      root.innerHTML = '<p class="panel empty muted">The Aethernal server is unreachable right now. It may be offline for maintenance.</p>';
    }
  }

  loadAethernal();
  setInterval(loadAethernal, 60_000);
</script>

<style>
  .chars { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }
  /* Also injected by script, hence global. */
  :global(.empty) { padding: 18px 20px; margin: 0; grid-column: 1 / -1; }
  .realm-status { font-family: var(--font-body); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; padding: 2px 10px; border-radius: 999px; border: 1px solid; }
  .realm-status.on { color: #86e6a0; border-color: #2a5c38; background: #16281c; }
  .realm-status.off { color: #ff9a9d; border-color: #5c2a2d; background: #2e1414; }

  /* The Aethernal cards are injected by script, so their styles must be global. */
  #aethernal :global(.char) { position: relative; overflow: hidden; border-top: 3px solid var(--class, var(--border)); display: flex; flex-direction: column; }
  #aethernal :global(.body) { padding: 18px 20px; display: flex; flex-direction: column; gap: 14px; flex: 1; }
  #aethernal :global(.body > footer) { margin-top: auto; }
  #aethernal :global(header) { display: flex; gap: 14px; align-items: center; }
  #aethernal :global(.portrait) { position: relative; flex-shrink: 0; width: 56px; height: 56px; }
  #aethernal :global(.class-icon) { width: 56px; height: 56px; border-radius: 8px; border: 2px solid var(--class); }
  #aethernal :global(.race-icon) {
    position: absolute; right: -6px; bottom: -6px; width: 24px; height: 24px;
    border-radius: 50%; border: 2px solid var(--panel); box-shadow: 0 0 0 1px var(--border);
  }
  #aethernal :global(.cname) { margin: 0; font-size: 1.35rem; color: var(--class); display: flex; align-items: center; gap: 8px; }
  #aethernal :global(.sub) { font-size: 0.9rem; }
  #aethernal :global(.cls) { display: block; color: var(--class); font-weight: 600; }
  #aethernal :global(.dot) { width: 9px; height: 9px; border-radius: 50%; background: var(--muted); opacity: 0.5; }
  #aethernal :global(.dot.on) { background: var(--ok); opacity: 1; box-shadow: 0 0 8px var(--ok); }
  #aethernal :global(.stats) { display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 0; }
  #aethernal :global(.stats dt) { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  #aethernal :global(.stats dd) { margin: 0; font-size: 1.25rem; font-weight: 700; }
</style>
