---
import Base from '../layouts/Base.astro';
import ModernCharacter from '../components/ModernCharacter.astro';
import OwnerFilter from '../components/OwnerFilter.astro';
import { aethernalApi, blizzardCharacters } from '../data/characters';
import { PRIORITY_OWNERS, sortRoster } from '../lib/wow';
import { loadModern } from '../lib/modern';

// Everyone who owns a Battle.net character, for sorting. Only Pat & Mimi (PRIORITY_OWNERS) get a filter
// button; everyone else's characters are friends', behind one Friends checkbox that starts off.
// Aethernal owners come from the realm API and are added once it answers.
const owners = [...new Set(blizzardCharacters.map((c) => c.owner).filter(Boolean))];
const isFriend = (c: any) => Boolean(c.owner) && !PRIORITY_OWNERS.includes(c.owner);

// Battle.net characters split by game. The Forever tab only shows once a character has
// game: 'forever' in characters.ts. The page script sorts the Aethernal cards the same way.
const fetched = loadModern()?.characters;
const modern = fetched && sortRoster(fetched.filter((c) => (c.game ?? 'modern') === 'modern'), owners);
// Failed Forever lookups are hidden rather than shown as error cards: a character only shows up on
// the API once it has logged in at level 10+, so until then the section shows a one-line note.
const forever = sortRoster((fetched ?? []).filter((c) => c.game === 'forever' && !c.error), owners);
const foreverListed = blizzardCharacters.filter((c) => c.game === 'forever');
// The first tab is the one shown on load (and when the URL names none).
const firstTab = foreverListed.length > 0 ? 'Forever' : 'Modern';
---
<Base title="Our Characters" description="Live World of Warcraft character profiles for Pat, Mimi and friends on Modern, Forever and the Aethernal server.">
  <h1>Our Characters</h1>
  <p class="lead">Our characters on Modern, Forever and Aethernal.</p>

  <div class="toolbar">
    <div class="tabs" role="tablist" aria-label="Game">
      {foreverListed.length > 0 && <button type="button" role="tab" class="tab" data-section-toggle="Forever" aria-selected={String(firstTab === 'Forever')}>Forever <span class="n" data-count></span></button>}
      <button type="button" role="tab" class="tab" data-section-toggle="Modern" aria-selected={String(firstTab === 'Modern')}>Modern <span class="n" data-count></span></button>
      <button type="button" role="tab" class="tab" data-section-toggle="Aethernal" aria-selected="false"><span id="realm-dot" class="realm-dot" hidden></span>Aethernal <span class="n" data-count></span></button>
    </div>
    <OwnerFilter owners={owners} core={PRIORITY_OWNERS} />
  </div>

  {foreverListed.length > 0 && (
    <section data-filter-group data-section="Forever" hidden={firstTab !== 'Forever'}>
      {forever.length ? (
        <>
          <div class="chars">
            {forever.filter((c: any) => !isFriend(c)).map((c: any) => <ModernCharacter c={c} />)}
          </div>
          {forever.some(isFriend) && (
            <div class="friends" data-filter-group>
              <h2 class="section-title friends-title">Friends</h2>
              <div class="chars">
                {forever.filter(isFriend).map((c: any) => <ModernCharacter c={c} />)}
              </div>
            </div>
          )}
          <p class="panel empty muted" data-filter-empty hidden>No characters here with these filters.</p>
        </>
      ) : (
        <p class="panel empty muted">Forever profiles appear here once they're on Battle.net.</p>
      )}
    </section>
  )}

  <section data-filter-group data-section="Modern" hidden={firstTab !== 'Modern'}>
    {modern ? (
      <>
        <div class="chars">
          {modern.map((c: any) => <ModernCharacter c={c} />)}
        </div>
        <p class="panel empty muted" data-filter-empty hidden>No characters here with these filters.</p>
      </>
    ) : (
      <p class="panel empty muted">Modern profiles appear here after the next deploy fetches them from Battle.net.</p>
    )}
  </section>

  <section data-filter-group data-section="Aethernal" hidden>
    <p class="realm-line"><span id="realm-status" class="realm-status" hidden></span></p>
    <div id="aethernal" class="chars" data-api={aethernalApi}>
      <p class="panel empty muted">Contacting the realm…</p>
    </div>
    <p class="panel empty muted" data-filter-empty hidden>No characters here with these filters.</p>
  </section>

  <script is:inline slot="head">
    const whTooltips = { colorLinks: false, iconizeLinks: true, renameLinks: false, iconSize: 'small' };
  </script>
  <script is:inline slot="head" src="https://wow.zamimg.com/js/tooltips.js" defer></script>
</Base>

<script>
  import { CLASS_COLORS, PRIORITY_OWNERS, sortRoster, classIconUrl, raceIconUrl, raceLabel, sortEquipment } from '../lib/wow';

  // Aethernal: fetched live from the account panel's public API.
  const root = document.getElementById('aethernal');
  const statusEl = document.getElementById('realm-status');
  const realmDot = document.getElementById('realm-dot');
  // Character names stay on one line. They share one size, the one that fits the longest name
  // (from 1.35rem), but that shared size doesn't go below 1.2rem; a name too long even for that (like Blinky Thedumb)
  // shrinks on its own, down to 13px. Re-run whenever a name's box changes size: first layout,
  // window resizes, cards shown or hidden by the filters.
  const SHARED_MIN = 1.2 * parseFloat(getComputedStyle(document.documentElement).fontSize);
  // scrollWidth/clientWidth are rounded to whole pixels, which misses text that's a fraction of a
  // pixel too wide (it still gets an ellipsis), so compare the text's exact width to the box's.
  const range = document.createRange();
  const overflows = (el) => {
    range.selectNodeContents(el);
    return range.getBoundingClientRect().width > el.getBoundingClientRect().width;
  };
  const fitsAt = (el, floor) => {
    let size = parseFloat(getComputedStyle(el).fontSize);
    while (overflows(el) && size - 0.5 >= floor) {
      size -= 0.5;
      el.style.fontSize = `${size}px`;
    }
    return size;
  };
  const fitAll = () => {
    const names = [...document.querySelectorAll('.char .cname')];
    names.forEach((el) => { el.style.fontSize = ''; });
    // Hidden names (filtered out) have no width to measure; they're fitted when they show again.
    const visible = names.filter((el) => el.clientWidth);
    if (!visible.length) return;
    const shared = `${Math.min(...visible.map((el) => fitsAt(el, SHARED_MIN)))}px`;
    names.forEach((el) => { el.style.fontSize = shared; });
    visible.forEach((el) => fitsAt(el, 13));
  };
  let fitQueued = false;
  const nameObserver = new ResizeObserver(() => {
    if (fitQueued) return;
    fitQueued = true;
    requestAnimationFrame(() => { fitQueued = false; fitAll(); });
  });
  const fitNames = () => {
    nameObserver.disconnect();
    document.querySelectorAll('.char .cname').forEach((el) => nameObserver.observe(el));
  };
  fitNames();
  // Cinzel can arrive after the first fit (common on phones), and swapping it in widens the names
  // without resizing their boxes, so refit whenever a font finishes loading.
  document.fonts?.ready.then(fitAll);
  document.fonts?.addEventListener?.('loadingdone', fitAll);

  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (ch) => `&#${ch.charCodeAt(0)};`);
  // AzerothCore has no character renders, so the portrait is Wowhead's class icon with a small
  // race/gender icon in the corner.
  const classIcon = (c) => classIconUrl(c.className);
  const raceIcon = (c) => raceIconUrl(c.race, c.gender);
  // Names and guilds open in the armory on the account panel (same tab, like the menu's Server link).
  const ARMORY = 'https://wow.aethernal.net/armory';
  const armoryLink = (path, name, text) =>
    `<a href="${ARMORY}/${path}/${encodeURIComponent(name)}" data-same-tab>${text}</a>`;
  const hoursMinutes = (sec) => `${Math.floor(sec / 3600)}h ${Math.floor(sec / 60) % 60}m`;
  // Over a day, show days and hours; hovering gives the total in hours and minutes.
  const played = (sec) => {
    const h = Math.floor(sec / 3600);
    return h >= 24
      ? `<span title="${hoursMinutes(sec)}">${Math.floor(h / 24)}d ${h % 24}h</span>`
      : hoursMinutes(sec);
  };

  function card(c) {
    const owner = c.owner;
    const color = CLASS_COLORS[c.className] || 'var(--text)';
    const gear = sortEquipment(c.equipment || [])
      .map((i) => `<li><span class="slot">${esc(i.slot)}</span>`
        + `<a href="https://www.wowhead.com/wotlk/item=${i.entry}" target="_blank" rel="noopener" style="color: var(--q${Number(i.quality) || 0})">${esc(i.name)}</a>`
        + `<span class="ilvl">${i.itemLevel ?? ''}</span></li>`)
      .join('');
    const professions = (c.professions || [])
      .map((p) => `<tr><td>${esc(p.name)}</td><td class="skill">${p.skill}${p.max ? `<span class="muted"> / ${p.max}</span>` : ''}</td></tr>`)
      .join('');
    return `
      <article class="char panel" style="--class: ${color}" data-filter-item data-owner="${esc(owner || '')}">
        ${owner || c.hardcore ? `<div class="tags">${owner ? `<span class="owner" data-owner="${esc(owner)}">${esc(owner)}</span>` : ''}${c.hardcore ? '<span class="hardcore" title="Hardcore">HC</span>' : ''}</div>` : ''}
        <div class="body">
          <header>
            <div class="portrait">
              <img class="class-icon" src="${classIcon(c)}" alt="${esc(c.className)}" width="56" height="56" loading="lazy">
              <img class="race-icon" src="${raceIcon(c)}" alt="${esc(`${c.gender} ${c.race}`)}" width="24" height="24" loading="lazy">
            </div>
            <div class="ident">
              <h3 class="cname">${armoryLink('character', c.name, esc(c.name))}
                <span class="dot ${c.online ? 'on' : ''}" title="${c.online ? 'Online' : 'Offline'}"></span>
              </h3>
              <div class="sub">Level ${c.level} <span title="${esc(c.race)}">${esc(raceLabel(c.race))}</span> <span class="cls">${c.spec ? `${esc(c.spec)} ` : ''}${esc(c.className)}</span></div>
              ${c.guild ? `<div class="sub muted">${armoryLink('guild', c.guild, `&lt;${esc(c.guild)}&gt;`)}</div>` : ''}
            </div>
          </header>
          <dl class="stats">
            ${c.itemLevel ? `<div><dt>Item level</dt><dd>${c.itemLevel}</dd></div>` : ''}
            <div><dt>Played</dt><dd>${played(c.playedSeconds || 0)}</dd></div>
            ${c.honorableKills ? `<div><dt>Honor kills</dt><dd>${c.honorableKills}</dd></div>` : ''}
          </dl>
          ${gear ? `<details class="acc"><summary><span>Equipment</span></summary><ul class="gear">${gear}</ul></details>` : ''}
          ${professions ? `<details class="acc"><summary><span>Professions</span></summary><table class="profs"><tbody>${professions}</tbody></table></details>` : ''}
          <footer class="small muted">${c.online ? 'Online now' : c.lastSeen ? `Last seen ${new Date(c.lastSeen).toLocaleDateString('en-CA', { dateStyle: 'medium', timeZone: 'America/Toronto' })}` : ''}</footer>
        </div>
      </article>`;
  }

  // The realm's status also shows as a dot on the Aethernal tab, so it's visible from the other tabs.
  const setDot = (online, text) => {
    realmDot.hidden = false;
    realmDot.className = `realm-dot ${online ? 'on' : 'off'}`;
    realmDot.title = `Aethernal server: ${text}`;
  };

  async function loadAethernal() {
    try {
      const res = await fetch(root.dataset.api);
      if (!res.ok) throw new Error(res.status);
      const data = await res.json();
      statusEl.hidden = false;
      statusEl.className = `realm-status ${data.realm.online ? 'on' : 'off'}`;
      statusEl.textContent = data.realm.online ? `Online · ${data.realm.playersOnline} playing` : 'Offline';
      setDot(data.realm.online, statusEl.textContent);
      window.addFilterOwners?.(data.characters.map((c) => c.owner));
      // Same order as the Battle.net cards, with the owners in filter-button order.
      const owners = [...document.querySelectorAll('.owner-filter [data-owner]')].map((b) => b.dataset.owner);
      const chars = sortRoster(data.characters, owners);
      // Friends' characters (anyone but Pat & Mimi) go in their own block, like on the Forever tab.
      const isFriend = (c) => Boolean(c.owner) && !PRIORITY_OWNERS.includes(c.owner);
      const friends = chars.filter(isFriend);
      root.innerHTML = chars.length
        ? chars.filter((c) => !isFriend(c)).map(card).join('')
          + (friends.length ? `<div class="friends" data-filter-group><h2 class="section-title friends-title">Friends</h2><div class="chars">${friends.map(card).join('')}</div></div>` : '')
        : '<p class="panel empty muted">No characters to show yet.</p>';
      window.applyOwnerFilter?.();
      fitNames();
      window.$WowheadPower?.refreshLinks();
    } catch {
      statusEl.hidden = false;
      statusEl.className = 'realm-status off';
      statusEl.textContent = 'Unreachable';
      setDot(false, 'Unreachable');
      root.innerHTML = '<p class="panel empty muted">The Aethernal server is unreachable right now. It may be offline for maintenance.</p>';
    }
  }

  // Refresh every minute, but only while the page is visible: background tabs don't poll the
  // server, and coming back to the tab refreshes at once if the data is older than that.
  const REFRESH_MS = 60_000;
  let loadedAt = 0;
  const refresh = () => {
    loadedAt = Date.now();
    loadAethernal();
  };
  refresh();
  setInterval(() => { if (document.visibilityState === 'visible') refresh(); }, REFRESH_MS);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible' && Date.now() - loadedAt >= REFRESH_MS) refresh();
  });
</script>

<style>
  /* Global too, for the Friends grid injected into the Aethernal tab. */
  .chars, #aethernal :global(.chars) { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }
  /* Also injected by script, hence global. */
  :global(.empty) { padding: 18px 20px; margin: 0; grid-column: 1 / -1; }
  /* One toolbar: game tabs on the left, the people filter on the right. */
  .toolbar {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 16px;
    border-bottom: 1px solid var(--border); margin: 0 0 20px;
  }
  .toolbar :global(.owner-filter) { margin: 0 0 8px; }
  .tabs { display: flex; flex-wrap: wrap; gap: 4px; }
  .tab {
    font: inherit; font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; letter-spacing: 0.03em;
    color: var(--muted); background: none; border: 0; border-bottom: 2px solid transparent; margin-bottom: -1px;
    padding: 6px 12px 8px; cursor: pointer; display: inline-flex; align-items: center; gap: 8px;
  }
  .tab:hover { color: var(--text); }
  .tab[aria-selected="true"] { color: var(--accent); border-bottom-color: var(--accent); }
  .tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  .tab .n {
    font-family: var(--font-body); font-size: 0.72rem; font-weight: 600; letter-spacing: 0;
    color: var(--muted); background: var(--panel-alt); border-radius: 999px; padding: 0 8px;
  }
  .tab .n:empty { display: none; }
  .realm-dot { width: 8px; height: 8px; border-radius: 50%; background: #ff6b6f; }
  .realm-dot.on { background: var(--ok); box-shadow: 0 0 8px var(--ok); }
  .realm-line { margin: 0 0 12px; }
  .realm-line:has(#realm-status[hidden]) { display: none; }
  /* Friends' characters, under Pat & Mimi's, shown with the Friends checkbox. Also injected by script. */
  :global(.friends) { grid-column: 1 / -1; }
  :global(.friends-title) { font-size: 1rem; color: var(--muted); margin: 28px 0 16px; }
  .realm-status { font-family: var(--font-body); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; padding: 2px 10px; border-radius: 999px; border: 1px solid; }
  .realm-status.on { color: #86e6a0; border-color: #2a5c38; background: #16281c; }
  .realm-status.off { color: #ff9a9d; border-color: #5c2a2d; background: #2e1414; }

  /* The Aethernal cards are injected by script, so their styles must be global. */
  #aethernal :global(.char) { position: relative; overflow: hidden; border-top: 3px solid var(--class, var(--border)); display: flex; flex-direction: column; }
  #aethernal :global(.body) { padding: 18px 20px; display: flex; flex-direction: column; gap: 14px; flex: 1; }
  #aethernal :global(.body > footer) { margin-top: auto; }
  #aethernal :global(header) { display: flex; gap: 14px; align-items: center; }
  #aethernal :global(.char:has(.tags) .cname) { margin-right: 72px; }
  #aethernal :global(.portrait) { position: relative; flex-shrink: 0; width: 56px; height: 56px; }
  #aethernal :global(.class-icon) { width: 56px; height: 56px; border-radius: 8px; border: 2px solid var(--class); }
  #aethernal :global(.race-icon) {
    position: absolute; right: -6px; bottom: -6px; width: 24px; height: 24px;
    border-radius: 50%; border: 2px solid var(--panel); box-shadow: 0 0 0 1px var(--border);
  }
  #aethernal :global(.ident) { flex: 1; min-width: 0; }
  #aethernal :global(.cname) { margin: 0; font-size: 1.35rem; color: var(--class); display: flex; align-items: center; gap: 8px; white-space: nowrap; overflow: hidden; }
  #aethernal :global(.cname .dot) { flex-shrink: 0; }
  #aethernal :global(.sub) { font-size: 0.9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #aethernal :global(.cname a), #aethernal :global(.sub a) { color: inherit; text-decoration: none; }
  #aethernal :global(.cname a:hover), #aethernal :global(.sub a:hover) { text-decoration: underline; text-underline-offset: 3px; }
  #aethernal :global(.cls) { display: block; color: var(--class); font-weight: 600; }
  #aethernal :global(.dot) { width: 9px; height: 9px; border-radius: 50%; background: var(--muted); opacity: 0.5; }
  #aethernal :global(.dot.on) { background: var(--ok); opacity: 1; box-shadow: 0 0 8px var(--ok); }
  #aethernal :global(.stats) { display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 0; }
  #aethernal :global(.stats dt) { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  #aethernal :global(.stats dd) { margin: 0; font-size: 1.25rem; font-weight: 700; }
  #aethernal :global(.stats dd [title]) { cursor: help; }
</style>
