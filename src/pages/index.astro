---
import Base from '../layouts/Base.astro';
import { destinations } from '../data/links';
---
<Base>
  <section class="hero">
    <img class="banner" src="/images/banner.webp" alt="Aethernal" width="1052" height="619" />
    <div class="ornate-divider" aria-hidden="true">&#9670;</div>
    <p class="lead">Our corner of the internet: a WoW private server, our characters, Magic decks and assorted projects.</p>
  </section>

  <div class="grid">
    {destinations.map((d) => (
      <a class="card panel" href={d.href} target={d.external ? '_blank' : undefined} rel={d.external ? 'noopener' : undefined}>
        <span class="tag">{d.tag}</span>
        <span class="card-title">{d.title} {d.external && <span class="ext">↗</span>}</span>
        <p class="card-desc">{d.description}</p>
      </a>
    ))}
  </div>
</Base>

<style>
  /* 32px main padding + 24px = banner 56px below the menu, same as on wow.aethernal.net. */
  .hero { text-align: center; margin: 24px 0 32px; }
  .banner {
    width: min(520px, 90%); height: auto; margin: 0 auto;
    filter: drop-shadow(0 0 22px rgba(var(--accent-rgb), 0.35));
    animation: frostGlow 4s ease-in-out infinite;
  }
  /* Same pulse as the logo on wow.aethernal.net. */
  @keyframes frostGlow {
    0%, 100% { filter: drop-shadow(0 0 16px rgba(var(--accent-rgb), 0.3)); }
    50% { filter: drop-shadow(0 0 30px rgba(var(--accent-rgb), 0.6)); }
  }
  .hero .lead { margin: 0 auto; }
</style>
