---
import { deckUrl, type Deck } from '../data/decks';
import { deckArt } from '../lib/archidekt';

interface Props {
  deck: Deck;
  compact?: boolean;
}

const { deck, compact = false } = Astro.props;
const art = await deckArt(deck.id);
---
<a class:list={['deck panel', { compact }]} href={deckUrl(deck.id)} target="_blank" rel="noopener">
  <div class="art" style={art ? `background-image: url('${art}')` : undefined}></div>
  <span class="name">{deck.name}</span>
</a>

<style>
  .deck {
    position: relative; display: flex; align-items: flex-end;
    aspect-ratio: 4 / 3; overflow: hidden;
    text-decoration: none; color: var(--text);
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .deck.compact { aspect-ratio: 16 / 9; }
  .art {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, var(--panel-alt), var(--bg-hi)) center / cover no-repeat;
    transition: transform 0.3s;
  }
  .art::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 35%, rgba(5, 7, 13, 0.92));
  }
  .name { position: relative; padding: 12px 14px; font-weight: 600; line-height: 1.3; text-shadow: 0 1px 3px #000; }
  .compact .name { font-size: 0.9rem; padding: 10px 12px; }
  .deck:hover, .deck:focus-visible {
    border-color: var(--border-hi); transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.5), 0 0 18px rgba(79, 199, 255, 0.12);
  }
  .deck:hover .art { transform: scale(1.04); }
</style>
