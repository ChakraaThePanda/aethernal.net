---
import { deckUrl, type Deck } from '../data/decks';
import { deckInfo } from '../lib/archidekt';

interface Props {
  deck: Deck;
  compact?: boolean;
  owner?: string; // shown as a tag, for lists that mix everyone's decks
}

const { deck, compact = false, owner } = Astro.props;
const { art, commanders } = await deckInfo(deck.id);
const commanderNames = commanders.map((c) => c.name).join(' & ');
---
<a
  class:list={['deck panel', { compact }]}
  href={deckUrl(deck.id)}
  target="_blank"
  rel="noopener"
  data-preview={commanders.map((c) => c.image).join(' ') || undefined}
  data-preview-alt={commanderNames || undefined}
>
  <div class="art" style={art ? `background-image: url('${art}')` : undefined}></div>
  {owner && <span class="owner-tag" data-owner={owner}>{owner}</span>}
  <span class="label">
    <span class="name">{deck.name}</span>
    {commanderNames && <span class="commander">{commanderNames}</span>}
  </span>
</a>

<style>
  .deck {
    position: relative; display: flex; align-items: flex-end;
    aspect-ratio: 4 / 3; overflow: hidden;
    text-decoration: none; color: var(--text);
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .deck.compact { aspect-ratio: 16 / 9; }
  .art {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, var(--panel-alt), var(--bg-hi)) center / cover no-repeat;
    transition: transform 0.3s;
  }
  .art::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 30%, rgba(var(--bg-rgb), 0.95));
  }
  .label { position: relative; display: flex; flex-direction: column; gap: 1px; padding: 12px 14px; text-shadow: 0 1px 3px #000; min-width: 0; }
  .name { font-weight: 600; line-height: 1.3; }
  .commander { font-size: 0.8rem; color: var(--muted); line-height: 1.3; }
  .compact .label { padding: 10px 12px; }
  .compact .name { font-size: 0.9rem; }
  .compact .commander { font-size: 0.72rem; }
  .deck:hover, .deck:focus-visible {
    border-color: var(--border-hi); transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.5), 0 0 18px rgba(var(--accent-rgb), 0.12);
  }
  .deck:hover .art { transform: scale(1.04); }
  .owner-tag {
    position: absolute; top: 10px; right: 10px;
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--owner, var(--text)); background: rgba(var(--bg-rgb), 0.8);
    border: 1px solid var(--owner, var(--border)); border-radius: 999px; padding: 1px 9px;
  }
</style>
