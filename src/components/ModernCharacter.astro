---
import { classColor, qualityVar, classIconUrl, raceIconUrl, rulesetLabel, raceLabel, sortEquipment } from '../lib/wow';

interface Props {
  c: any; // one entry from src/data/generated/modern.json
}

const { c } = Astro.props;
const color = classColor(c.className);
// Forever characters live on a ruleset rather than a server, so that goes where the realm would.
const where = rulesetLabel(c.ruleset) ?? c.realm;
const hardcore = rulesetLabel(c.ruleset) === 'Hardcore';
// Item links point at the matching Wowhead database, so the link and its tooltip show the item as it
// is in that game (Forever items live under /forever/, Modern under the root).
const wowheadItem = c.game === 'forever' ? 'https://www.wowhead.com/forever/item=' : 'https://www.wowhead.com/item=';
const lastSeen = c.lastLogin ? new Date(c.lastLogin).toLocaleDateString('en-CA', { dateStyle: 'medium', timeZone: 'America/Toronto' }) : null;

// Where the character stands in its render (measured during the deploy, see scripts/render-figure.mjs).
// Typical values stand in when it couldn't be measured, so the render still shows.
const fig = c.figure ?? { top: 0.21, height: 0.6, bodyW: 0.16, centerX: 0.5, headL: 0.45, headR: 0.55, headB: 0.29 };

const DIFF_SHORT: Record<string, string> = { LFR: 'LFR', NORMAL: 'N', HEROIC: 'H', MYTHIC: 'M' };
// Endgame sections only for characters at the level cap (taken from the journal's newest raids,
// so it follows new expansions). If the cap couldn't be determined, show them anyway.
const atCap = !c.maxLevel || c.level >= c.maxLevel;
const raids = atCap ? (c.raids?.raids ?? []) : [];
const mplus = atCap ? c.mythicPlus : null;
// Shown on the Raids button: the newest raid's hardest difficulty with any kills (none if no kills).
const headline = (() => {
  const raid = raids[0];
  if (!raid) return null;
  const best = [...raid.progress].reverse().find((p: any) => p.killed > 0);
  return best ? `${best.killed}/${best.total} ${DIFF_SHORT[best.difficulty]}` : null;
})();

const sections = [
  c.equipment?.length > 0 && { key: 'gear', title: 'Gear' },
  c.professions?.length > 0 && { key: 'profs', title: 'Professions' },
  mplus && { key: 'mplus', title: 'Mythic+' },
  raids.length > 0 && { key: 'raids', title: 'Raids', value: headline },
].filter(Boolean) as { key: string; title: string; value?: string | null }[];
---
{c.error ? (
  <article class="char banner panel">
    <div class="top"><span class="where">{where}</span></div>
    <header><div class="ident"><h3 class="cname">{c.name}</h3><div class="line muted">{c.error}</div></div></header>
  </article>
) : (
  <article class="char banner panel" style={`--class: ${color}`} data-filter-item data-owner={c.owner}>
    <div class="glow"></div>
    {c.render && (
      <div
        class="art"
        style={`background-image: url('${c.render}'); --ft: ${fig.top}; --fh: ${fig.height}; --fw: ${fig.bodyW}; --fx: ${fig.centerX}`}
        data-head-l={fig.headL} data-head-r={fig.headR} data-head-b={fig.headB}
        role="img" aria-label={`${c.name} character render`}
      ></div>
    )}
    <div class="shade"></div>

    <div class="top">
      <div class="pills">
        {c.owner && <span class="owner" data-owner={c.owner}>{c.owner}</span>}
        {hardcore && <span class="hardcore" title="Hardcore">HC</span>}
      </div>
      <span class="where">
        {where}
        {c.guild && <> · {c.guildUrl
          ? <a href={c.guildUrl} target="_blank" rel="noopener" title="Open the guild in the Armory">&lt;{c.guild}&gt;</a>
          : <>&lt;{c.guild}&gt;</>}</>}
      </span>
    </div>

    <header>
      {c.avatar ? (
        <div class="portrait"><img class="main" src={c.avatar} alt="" width="60" height="60" loading="lazy" /></div>
      ) : (
        // No Blizzard avatar (Forever's media endpoint 404s for some): class icon with a race badge.
        <div class="portrait">
          <img class="main" src={classIconUrl(c.className)} alt={c.className} width="60" height="60" loading="lazy" />
          <img class="race-icon" src={raceIconUrl(c.race, c.gender)} alt={`${c.gender ?? ''} ${c.race}`.trim()} width="24" height="24" loading="lazy" />
        </div>
      )}
      <div class="ident">
        <h3 class="cname"><a href={c.profileUrl} target="_blank" rel="noopener" title="Open in the Armory">{c.name}</a></h3>
        <div class="line">Level {c.level} <span title={c.race}>{raceLabel(c.race)}</span></div>
        <div class="line cls">{c.spec ? `${c.spec} ` : ''}{c.className}</div>
        {lastSeen && <div class="line seen">Last seen {lastSeen}</div>}
      </div>
    </header>

    <div class="rest">
      {(c.itemLevel || mplus?.value != null) && (
        <div class="chips">
          {c.itemLevel && <span class="chip">Item level <b>{c.itemLevel}</b></span>}
          {mplus?.value != null && <span class="chip">M+ <b style={mplus.color ? `color: ${mplus.color}` : undefined}>{mplus.value}</b></span>}
        </div>
      )}

      {sections.length > 0 && (
        <div class="sections">
          {sections.map((s) => (
            <button type="button" data-open={s.key} aria-expanded="false">{s.title}{s.value && <span class="val">{s.value}</span>}</button>
          ))}
        </div>
      )}

      {c.equipment?.length > 0 && (
        <div class="drawer" data-drawer="gear" hidden>
          <ul class="gear">
            {sortEquipment(c.equipment).map((i: any) => (
              <li>
                <span class="slot">{i.slot}</span>
                <a href={`${wowheadItem}${i.id}`} target="_blank" rel="noopener" style={`color: ${qualityVar(i.quality)}`}>{i.name}</a>
                <span class="ilvl">{i.itemLevel}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {c.professions?.length > 0 && (
        <div class="drawer" data-drawer="profs" hidden>
          <table class="profs">
            <tbody>
              {c.professions.map((p: any) => (
                <tr>
                  <td title={p.tier ?? undefined}>
                    {p.name}
                    {p.max ? <div class="bar"><i style={`width: ${Math.min(100, Math.round((100 * p.skill) / p.max))}%`}></i></div> : null}
                  </td>
                  <td class="skill">{p.skill}{p.max ? <span class="muted"> / {p.max}</span> : ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {mplus && (
        <div class="drawer" data-drawer="mplus" hidden>
          <div class="drawer-head">
            <span>{mplus.season}</span>
            {mplus.value != null && <span>Rating <b style={mplus.color ? `color: ${mplus.color}` : undefined}>{mplus.value}</b></span>}
          </div>
          {mplus.runs.length ? (
            <table class="rows">
              <tbody>
                {mplus.runs.map((r: any) => (
                  <tr>
                    <td>{r.dungeon}</td>
                    {r.level == null ? (
                      <td class="key none" title="Not done this season">–</td>
                    ) : (
                      <td class={r.timed ? 'key timed' : 'key depleted'} title={r.timed ? 'Timed' : 'Over time'}>+{r.level}</td>
                    )}
                    <td class={r.rating == null ? 'num none' : 'num'} style={r.color ? `color: ${r.color}` : undefined}>{r.rating ?? '–'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          ) : (
            <p class="drawer-empty">No runs this season yet.</p>
          )}
        </div>
      )}

      {raids.length > 0 && (
        <div class="drawer" data-drawer="raids" hidden>
          <div class="drawer-head"><span>{c.raids.expansion}</span></div>
          <table class="rows raids">
            <thead>
              <tr>
                <th></th>
                {raids[0].progress.map((p: any) => <th class="num">{DIFF_SHORT[p.difficulty]}</th>)}
              </tr>
            </thead>
            <tbody>
              {raids.map((r: any) => (
                <tr>
                  <td title={r.name}>{r.name}</td>
                  {r.progress.map((p: any) => (
                    <td class:list={['num', { done: p.total > 0 && p.killed === p.total, none: p.killed === 0 }]}>{p.killed}/{p.total}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </article>
)}
